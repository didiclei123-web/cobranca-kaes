{
  "manifest_version": 3,
  "name": "Cobranças KAES",
  "version": "1.0.0",
  "description": "Confere vencidos no ClickUp, busca as cobranças no Asaas, gera mensagens e atualiza o ClickUp — por cliques, sem API.",
  "permissions": ["sidePanel", "tabs", "scripting", "debugger", "storage", "clipboardWrite"],
  "host_permissions": ["https://app.clickup.com/*", "https://www.asaas.com/*"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "painel.html" },
  "action": {
    "default_title": "Cobranças KAES",
    "default_icon": { "16": "icones/16.png", "32": "icones/32.png", "48": "icones/48.png", "128": "icones/128.png" }
  },
  "icons": { "16": "icones/16.png", "32": "icones/32.png", "48": "icones/48.png", "128": "icones/128.png" }
}
